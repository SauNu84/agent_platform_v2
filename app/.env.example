# Agent Platform — Slice 1 environment.
# Copy to .env (gitignored). All values are optional for dev/demo.

# Postgres. Without it, the app uses a NON-DURABLE in-memory store (dev/demo only)
# and refuses to boot in production. Apply db/migrations with `npm run migrate`.
# DATABASE_URL=postgres://user:pass@localhost:5432/agent_platform

# Realtime voice vendor behind the stable seam (ADR-003): 'openai' | 'mock'.
# Defaults to 'mock' in dev when no OPENAI_API_KEY is present so `Join` works
# with zero credentials.
# REALTIME_VENDOR=openai

# OpenAI Realtime (the Slice-0-proven vendor). Required for live browser voice
# and the OpenAI server-driven path. Provisioned out-of-band; NEVER commit.
# OPENAI_API_KEY=sk-...
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_VOICE=alloy

# Google Gemini 2.5 Flash Live (SAU-258/259) — the user-selectable cheaper engine
# (~⅓ the cost of gpt-realtime). Required for the live BROWSER Gemini session; the
# server mints a short-lived ephemeral token from this key (the key never reaches
# the client). Absent ⇒ Gemini selection falls back to the simulated session (no
# crash). Provisioned out-of-band (CPO spend approval); NEVER commit.
# GEMINI_API_KEY=AIza...
# GEMINI_VOICE=Aoede                # Gemini prebuilt voice (Aoede|Puck|Charon|Kore|...)
# VOICE_ENGINE_GEMINI=gemini-2.5-flash-preview-native-audio-dialog

# Secrets-at-rest key (SAU-260/261). 32-byte hex; encrypts BYO provider keys AND
# the Google Calendar OAuth tokens (SAU-271). REQUIRED in production (server crashes
# on boot if absent); dev/test falls back to an insecure fixed key. NEVER commit.
# SETTINGS_ENCRYPTION_KEY=<64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# ── Calendar booking adapter (SAU-267 Phase 0 → SAU-271 Phase 1 · WS2) ─────────-
# Vendor-neutral seam. Resolution order per clinic: per-user Google OAuth connection
# (below) → env sandbox token → simulated mock. Absent everything ⇒ deterministic
# mock calendar (no crash). SYNTHETIC patients only until the HIPAA gate (SAU-272).
# CALENDAR_PROVIDER=auto                  # 'auto' | 'mock' (forces the simulated adapter)
#
# Phase-1 WS2 — per-clinic Google Calendar OAuth (authorization-code + refresh).
# The clinic owner connects their real calendar in Settings → Integrations; we store
# an ENCRYPTED refresh token and mint access tokens on demand. Client id/secret are
# the platform's Google OAuth app, provisioned out-of-band; absent ⇒ Connect button
# is disabled and booking stays on the sandbox/mock. NEVER commit.
# GOOGLE_OAUTH_CLIENT_ID=<app>.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...
# GOOGLE_OAUTH_REDIRECT_URI=              # optional override; else <origin>/api/integrations/google-calendar/callback
#
# Phase-0 sandbox token (simplest path that writes real events; superseded by OAuth
# above when a clinic connects). A short-lived OAuth bearer with calendar scope.
# GOOGLE_CALENDAR_ACCESS_TOKEN=ya29....
# GOOGLE_CALENDAR_ID=primary              # sandbox/test calendar id
# ── Telephony ingress (SAU-270, Phase 1 · WS1) — inbound phone → clinic agent ──
# Buy-don't-build (SAU-254/255): Twilio for voice + SMS + BAA in one vendor.
# Key-gated + fail-soft: absent creds ⇒ the inbound webhook answers with a polite
# spoken notice + hangup (simulated telephony), never a crash. INBOUND ONLY in this
# phase; SYNTHETIC callers / internal test numbers only (no real patients — HIPAA
# gate = SAU-268). Provisioned out-of-band; NEVER commit.
# These can also be set in-app (Settings → Integrations → Phone call, SAU-381); env
# vars here always take precedence over the saved setting. Either way, live DIALING
# stays gated behind the SAU-331 go-live gate (COLLECTIONS_LIVE_DIAL_CONFIRMED).
# TELEPHONY_PROVIDER=auto                 # 'auto' | 'mock' (forces the simulated adapter)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx           # SID + token present ⇒ live Twilio adapter
# TWILIO_AUTH_TOKEN=...                    # used ONLY to verify inbound X-Twilio-Signature
# TWILIO_PHONE_NUMBER=+15551234567         # the provisioned test number (E.164)
# TWILIO_VERIFY_SIGNATURES=true            # set false for local tunnels (dev only)
# TELEPHONY_DEFAULT_SCENARIO=clinic-intake-booking  # dialed number → this scenario
#
# Media-stream bridge server (run `npm run bridge`; expose over a tunnel/ngrok so
# Twilio can reach wss://<public>/telephony/bridge). The webhook returns TwiML that
# streams call audio here, where it's bridged to OpenAI Realtime (g711_ulaw, no
# transcode). Uses OPENAI_API_KEY above; no key ⇒ the bridge closes the socket
# cleanly with a log line.
# TELEPHONY_PUBLIC_URL=wss://abc123.ngrok.io   # public wss base of the bridge server
# TELEPHONY_BRIDGE_PORT=5050                    # local port the bridge listens on
# TELEPHONY_PUBLIC_WEBHOOK_URL=                 # override webhook URL for signature checks
#
# Per-tenant call admission (SAU-525). The bridge resolves the dialed number (`To`)
# to a clinic (clinic.phone_number, bound via PATCH /api/use-cases/clinic-agent/
# clinics/telephony), bills the clinic OWNER (tier + monthly cap + voice_usage row)
# and runs the clinic's engine grade (clinic.voice_engine: standard|premium, default
# standard = the cost engine). An unbound number is REFUSED — there is no unmetered
# path. The only fallback is a clinic SLUG to bill when the number is unbound (dev/
# trial number); it is still metered to that clinic's owner.
# TELEPHONY_FALLBACK_CLINIC=                    # clinic slug; unset ⇒ unbound numbers refused
# VOICE_ENGINE_TENANT_STANDARD=                 # clinic 'standard' model; unset ⇒ VOICE_ENGINE_FREE (gpt-realtime-mini)
# VOICE_ENGINE_TENANT_PREMIUM=                  # clinic 'premium' model;  unset ⇒ VOICE_ENGINE_PAID (gpt-realtime)

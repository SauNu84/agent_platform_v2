# Slice-0 realtime-voice spike — vendor credentials (SAU-181)
#
# HOW TO USE: copy this file to `.env` in THIS directory and fill in real values.
#   cp .env.example .env   # then edit .env
# `.env` is gitignored — it is NEVER committed. bench.ts auto-loads it at startup.
# Exported environment variables take precedence over `.env`.
#
# OpenAI-first is enough to start (satisfies the SAU-176 "≥1 vendor" bar).
# The other five can be added later (SAU-182).

OPENAI_API_KEY=
# GOOGLE_API_KEY=
# LIVEKIT_URL=          # only needed for the @livekit/agents wrapper (Option A), not the direct cascade
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# CARTESIA_API_KEY=     # cascade TTS
# CARTESIA_VOICE_ID=    # a Cartesia voice UUID (adapter defaults + warns if unset)
# DEEPGRAM_API_KEY=     # cascade STT — REQUIRED for `--vendor livekit`; NOT in SAU-182's original 5-key list
